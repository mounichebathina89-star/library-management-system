PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/library-management?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_secure_random_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
GROQ_API_KEY=your_groq_api_key_here

# For production deployment, set CLIENT_URL to your deployed frontend URL, for example:
# CLIENT_URL=https://library-management-app.vercel.app